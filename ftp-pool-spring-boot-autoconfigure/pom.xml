<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.ftppool</groupId>
        <artifactId>ftp-pool</artifactId>
        <version>0.1.0-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>ftp-pool-spring-boot-autoconfigure</artifactId>
    <name>FtpPool Spring Boot Autoconfigure</name>
    <description>Spring Boot auto-configuration (@Configuration, @ConfigurationProperties, conditional beans).</description>

    <dependencies>
        <dependency>
            <groupId>io.ftppool</groupId>
            <artifactId>ftp-pool-api</artifactId>
        </dependency>
        <dependency>
            <groupId>io.ftppool</groupId>
            <artifactId>ftp-pool-core</artifactId>
        </dependency>
        <dependency>
            <groupId>io.ftppool</groupId>
            <artifactId>ftp-pool-adapter</artifactId>
        </dependency>
        <dependency>
            <groupId>io.ftppool</groupId>
            <artifactId>ftp-pool-engine-fast</artifactId>
        </dependency>
        <dependency>
            <groupId>io.ftppool</groupId>
            <artifactId>ftp-pool-observability</artifactId>
        </dependency>
        <dependency>
            <groupId>io.ftppool</groupId>
            <artifactId>ftp-pool-micrometer</artifactId>
        </dependency>
        <dependency>
            <groupId>io.ftppool</groupId>
            <artifactId>ftp-pool-jmx</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-autoconfigure</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-actuator</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-autoconfigure-processor</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-configuration-processor</artifactId>
            <optional>true</optional>
        </dependency>
    </dependencies>
</project>